# Opcional: chave gratuita obtida em https://my.plantnet.org/
PLANTNET_API_KEY=
# Opcional: chave do CRIA para registros científicos brasileiros
SPECIESLINK_API_KEY=
# Senha obrigatória na Vercel, Supabase e nos scripts de rede local.
CAMPO_PASSWORD=
# Diretório persistente; padrão: ./data
CAMPO_DATA_DIR=./data

# Armazenamento: local (SQLite) ou supabase (PostgreSQL + bucket privado)
CAMPO_STORAGE=local
# Na Vercel, use CAMPO_STORAGE=supabase e preencha todas as variáveis abaixo.
# Conexão Transaction pooler do Supabase (porta 6543), somente no servidor.
DATABASE_URL=
SUPABASE_URL=
# Chave service_role/secret, nunca use NEXT_PUBLIC_ para esta chave.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campo-private
