# Opcional: fotos de natureza; chave somente no servidor, obtida em https://www.pexels.com/api/
PEXELS_API_KEY=
# Opcional: chave gratuita obtida em https://my.plantnet.org/
PLANTNET_API_KEY=
# Opcional: chave do CRIA para registros científicos brasileiros
SPECIESLINK_API_KEY=
# Senha obrigatória no modo compartilhado hospedado/rede local. Em CAMPO_AUTH=supabase, use contas.
CAMPO_PASSWORD=
# Diretório persistente; padrão: ./data
CAMPO_DATA_DIR=./data

# Armazenamento: local (SQLite) ou supabase (PostgreSQL + bucket privado)
CAMPO_STORAGE=local
# Na Vercel, use CAMPO_STORAGE=supabase e preencha todas as variáveis abaixo.
# Conexão Transaction pooler do Supabase (porta 6543), somente no servidor.
DATABASE_URL=
SUPABASE_URL=
# Chave service_role/secret, nunca use NEXT_PUBLIC_ para esta chave.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campo-private

# Opcional: contas e organizações. Exige Supabase e a migration profissional.
# Depois da migration profissional, não volte para a senha compartilhada nesse banco.
# CAMPO_AUTH=supabase
# Chave anon/publishable do Supabase Auth (diferente da service_role).
SUPABASE_ANON_KEY=
